# Copy to .env (never commit .env)

# Provider order: gemini (free tier) -> local -> openai (last resort)
LLM_PROVIDER=gemini

# Google AI Studio key (free tier)
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBED_MODEL=

# OpenAI API key (paid; last resort). A ChatGPT subscription alone does not provide API access.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBED_MODEL=

# Cost guard: runs stop above this many dollars
MAX_USD_BUDGET=0.50

# LangSmith (tracing is off until enabled)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-frameworks-lab
# LANGSMITH_ENDPOINT=   # non-US accounts only

LOG_LEVEL=INFO
